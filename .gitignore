# Compiled & raw ECU binaries (copyrighted OEM ROMs and candidate flash outputs; case-insensitive)
*.[bB][iI][nN]
*.[sS]19
*.[rR][oO][mM]
*.[hH][eE][xX]
*.[sS][rR][eE][cC]

# Live & logged vehicle telemetry / simulation Parquet lakes and SQLite/DuckDB stores
data/drives/**
!data/drives/.gitkeep
data/lake/**
*.parquet
*.duckdb
*.duckdb.wal
**/*.sqlite
**/*.sqlite3
**/*.sqlite-wal
**/*.sqlite-shm
**/*.db
**/*.db-wal
**/*.db-shm

# Raw copyright/private heritage archives, stock ROM inputs/baselines & user dumps (curated cleanroom digests live in knowledge/)
data/heritage_raw/**
!data/heritage_raw/.gitkeep
rom/inputs/**
!rom/inputs/.gitkeep
!rom/inputs/README.md
rom/stock_baselines/**
!rom/stock_baselines/.gitkeep
!rom/stock_baselines/README.md
private_references/
private_references/**
Private References/
Private References/**

# Secrets, local env overrides, and personal local Claude instructions
.env
.env.*
!.env.example
secrets.env
*.pem
*.key
CLAUDE.local.md
.claude/settings.local.json

# Python / Node / IDE artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
dist/
build/
*.egg-info/
node_modules/
.DS_Store
Thumbs.db
tags
*.log
